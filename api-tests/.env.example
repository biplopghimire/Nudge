# Copy to .env (git ignores it). Never commit real tokens.

# Canvas: Account > Settings > Approved Integrations > New Access Token
CANVAS_API_TOKEN=
CANVAS_DOMAIN=canvas.cmu.edu
# Course to print assignments for (matches course_code)
CANVAS_COURSE_CODE=67443
# Teacher/TA test: course to import (defaults to the first 67272 course you teach or TA)
CANVAS_TEACHER_COURSE_ID=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

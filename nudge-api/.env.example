# Copy to .env. Everything defaults to mock, so this file is optional.

# memory | postgres
NUDGE_REPOSITORY=memory
# Needed when NUDGE_REPOSITORY=postgres (Supabase: Project Settings > Database > Connection string)
NUDGE_DATABASE_URL=

# mock | gemini
NUDGE_AI=mock
NUDGE_GEMINI_API_KEY=

# mock | gcs
NUDGE_STORAGE=mock
NUDGE_BUCKET=nudge-course-files

NUDGE_CURRENT_SEMESTER=Fall 2026
# Seconds a mock upload stays "processing"
NUDGE_MOCK_PROCESSING_SECONDS=5

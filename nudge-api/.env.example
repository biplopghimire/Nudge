# Copy to .env (git ignores it). Everything defaults to mock, so this file is optional.

# memory | postgres
NUDGE_REPOSITORY=memory
# Local Postgres.app: postgresql:///nudge   Supabase: Project Settings > Database > Connection string
NUDGE_DATABASE_URL=

# mock | gemini
NUDGE_AI=mock
NUDGE_GEMINI_API_KEY=
# Tried in order when a model is busy (JSON list)
# NUDGE_GEMINI_CHAT_MODELS=["gemini-3.5-flash","gemini-2.5-flash","gemini-3.5-flash-lite"]
# NUDGE_GEMINI_TRANSCRIBE_MODELS=["gemini-3.5-flash-lite","gemini-2.5-flash"]
# NUDGE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# mock | jwt   (jwt = real passwords and signed login tokens)
NUDGE_AUTH=mock
# Required for jwt: python -c "import secrets; print(secrets.token_urlsafe(48))"
NUDGE_JWT_SECRET=
# Password for the example accounts that scripts/db.py loads when NUDGE_AUTH=jwt
NUDGE_SEED_PASSWORD=

# mock | local | gcs   (local keeps files in nudge-api/.storage)
NUDGE_STORAGE=mock
NUDGE_BUCKET=nudge-course-files

NUDGE_CURRENT_SEMESTER=Fall 2026
# Seconds a mock upload stays "processing"
NUDGE_MOCK_PROCESSING_SECONDS=5

{
  "method": "PATCH",
  "path": "/teacher/courses/{courseId}/settings",
  "description": "Teacher changes how Nudge helps in this course. Send only the switches that changed. deadlineReminders turns reminders on for every student in the course; each student can still mute them on PATCH /student/me.",
  "usedOn": [
    "Teacher · Options"
  ],
  "types": {
    "request": "UpdateCourseSettingsRequest",
    "response": "UpdateCourseSettingsResponse"
  },
  "request": {
    "params": {
      "courseId": "c0000000-0272-4000-8000-000000000001"
    },
    "body": {
      "deadlineReminders": true
    }
  },
  "response": {
    "status": 200,
    "body": {
      "settings": {
        "hintsOnly": true,
        "useSolutionKeys": true,
        "citeMaterials": true,
        "deadlineReminders": true
      }
    }
  }
}
